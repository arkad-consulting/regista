#!/bin/bash
# Pre-push gate: the click audits of whole screens and the whole journeys, which the commit hook leaves out because they
# take most of the suite's time. Every control of every screen and window is clicked (Tests/RegistaAppTests/
# ScreenClickTests.swift, WindowsClickTests.swift) and three pieces of work are driven by clicks from an empty app to an
# exported file (JourneyTests.swift) before anything is published. Skip in an emergency: git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

log="$(mktemp -t regista-prepush)"
trap 'rm -f "$log"' EXIT
echo "pre-push: click audits of every screen, then the journeys…"
if ! scripts/test.sh --filter 'ScreenClickTests|WindowsClickTests|JourneyTests' >"$log" 2>&1; then
  echo "pre-push: the click audits or the journeys failed:" >&2
  grep -E "✘|recorded an issue|error:|test\.sh:" "$log" | tail -40 >&2 || tail -40 "$log" >&2
  exit 1
fi
grep -E "Test run with" "$log" | tail -1
