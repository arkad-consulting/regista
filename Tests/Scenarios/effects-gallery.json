{
  "name": "effects-gallery",
  "defaults": {"REGISTA_GOLDEN_MEDIA": "${HOME}/.config/regista/test-media/wesites-2026-10-26"},
  "description": "Effects for users (issue #16) on the 2026-10-26 WeSites take: five linked segments, the WeSites kit, a film look at 60 % + adjustments on the whole picture, speed changes (0.5× slow motion, a hero ramp, a reversed clip, a freeze frame), a glitch and a punch-in, a sticker, a circle callout, a progress bar, a logo sting, a whip transition, punches on given beats and the Pulito style; exported 9:16. Checks: durations after each speed change, the export lasts the timeline, A/V sync under one frame on the plain clips (media.checkSync) and on the slowed/ramped ones (effects.check: stretched sound against the picture), every effect visible in its window (frame with vs without it), a look at intensity 0 identical to no look, nothing generated in the caption band, one undo step for the style. Needs only the footage (ffmpeg for audio and the reversed copy). The take's sound is not levelled (no audio.clean without the engines): the voice-loudness rule fails and it exports anyway.",
  "requires": ["footage"],
  "footage": ["${REGISTA_GOLDEN_MEDIA}/raw/IMG_3437.MOV", "${REGISTA_GOLDEN_MEDIA}/assets/wesites-mark.svg"],
  "steps": [
    {"command": "project.new", "params": {"name": "effects-gallery", "directory": "${WORK}"}},
    {"command": "media.import", "params": {"path": "${REGISTA_GOLDEN_MEDIA}/raw/IMG_3437.MOV"}, "capture": {"raw": "result.asset.id"}},
    {"command": "media.extractAudio", "params": {"assetId": "${raw}"}},
    {"command": "track.add", "params": {"kind": "video"}, "capture": {"v": "result.track.id"}},
    {"command": "track.add", "params": {"kind": "audio"}, "capture": {"a": "result.track.id"}},

    {"command": "timeline.place", "params": {"assetId": "${raw}", "trackId": "${v}", "sourceIn": 3, "sourceOut": 7}, "capture": {"c1": "result.clip.id"}},
    {"command": "timeline.place", "params": {"assetId": "${raw}", "trackId": "${a}", "sourceIn": 3, "sourceOut": 7, "linkTo": "${c1}"}},
    {"command": "timeline.place", "params": {"assetId": "${raw}", "trackId": "${v}", "sourceIn": 12, "sourceOut": 15}, "capture": {"c2": "result.clip.id"}},
    {"command": "timeline.place", "params": {"assetId": "${raw}", "trackId": "${a}", "sourceIn": 12, "sourceOut": 15, "linkTo": "${c2}"}},
    {"command": "timeline.place", "params": {"assetId": "${raw}", "trackId": "${v}", "sourceIn": 22, "sourceOut": 26}, "capture": {"c3": "result.clip.id"}},
    {"command": "timeline.place", "params": {"assetId": "${raw}", "trackId": "${a}", "sourceIn": 22, "sourceOut": 26, "linkTo": "${c3}"}},
    {"command": "timeline.place", "params": {"assetId": "${raw}", "trackId": "${v}", "sourceIn": 40, "sourceOut": 42}, "capture": {"c4": "result.clip.id"}},
    {"command": "timeline.place", "params": {"assetId": "${raw}", "trackId": "${a}", "sourceIn": 40, "sourceOut": 42, "linkTo": "${c4}"}},
    {"command": "timeline.place", "params": {"assetId": "${raw}", "trackId": "${v}", "sourceIn": 50, "sourceOut": 54}, "capture": {"c5": "result.clip.id"}},
    {"command": "timeline.place", "params": {"assetId": "${raw}", "trackId": "${a}", "sourceIn": 50, "sourceOut": 54, "linkTo": "${c5}"},
     "expect": {"state.duration": 17}},
    {"command": "brandkit.apply", "params": {"kit": "wesites", "captions": false}},

    {"command": "look.apply", "params": {"look": "film", "amount": 0.6}, "expect": {"result.grade.look": "film", "result.grade.amount": 0.6}},
    {"command": "adjust.set", "params": {"exposure": 0.08, "contrast": 0.12, "warmth": 0.1, "vignette": 0.35},
     "expect": {"result.grade.adjust.vignette": 0.35}},

    {"command": "clip.speed", "params": {"clipId": "${c2}", "rate": 0.5},
     "expect": {"result.duration": 6, "result.delta": 3, "result.linked": {"count": 1}, "result.speed.audio": "pitch", "state.duration": 20}},
    {"command": "clip.speed", "params": {"clipId": "${c3}", "preset": "hero"},
     "expect": {"result.duration": {"min": 9, "max": 9.8}, "result.speed.audio": "pitch"}, "capture": {"hero": "result"}},
    {"command": "clip.speed", "params": {"clipId": "${c4}", "reverse": true},
     "expect": {"result.duration": 2, "result.speed.audio": "mute", "result.speed.reverse": true}},
    {"command": "clip.speed", "params": {"clipId": "${c1}", "freezeAt": 2, "freezeDuration": 1},
     "expect": {"result.clip.speed.freeze": true, "result.duration": 1, "state.tracks.0.clips": {"count": 7}}, "capture": {"freeze": "result.clip.id"}},

    {"command": "effect.add", "params": {"kind": "glitch", "clipId": "${c5}", "start": 24, "end": 24.3, "amount": 1}},
    {"command": "effect.add", "params": {"kind": "punchZoom", "clipId": "${c2}", "start": 7, "end": 7.5, "zoom": 1.18}},
    {"command": "sticker.add", "params": {"sticker": "sparkles", "start": 5.5, "size": 200, "animIn": "bounce"}, "expect": {"result.warnings": {"count": 0}}},
    {"command": "callout.add", "params": {"kind": "circle", "start": 9, "duration": 2, "rect": [300, 380, 480, 420]}, "expect": {"result.warnings": {"count": 0}}},
    {"command": "progress.add", "params": {"thickness": 10}},
    {"command": "logo.animate", "params": {"motion": "sting"}, "expect": {"result.clip.keyframes": 5}},
    {"command": "transition.add", "params": {"kind": "whip", "clipId": "${c5}"}},
    {"command": "edit.beatSync", "params": {"beats": [14.5, 15, 15.5, 16, 16.5, 17, 17.5, 18], "every": 4}, "expect": {"result.added": 2}},

    {"command": "style.apply", "params": {"style": "pulito", "intensity": 0.6}, "expect": {"result.applied": {"count": 2}, "result.brand": "wesites"}},
    {"command": "history.undo", "expect": {"result.undone": "style.apply", "state.grade.look": "film"}},
    {"command": "history.redo", "expect": {"result.redone": "style.apply", "state.grade.look": "airy"}},
    {"command": "project.state", "capture": {"state": "result"}},

    {"command": "graphics.checkLayout", "params": {"step": 3}, "expect": {"result.pass": true}},
    {"command": "export.render", "params": {"path": "${WORK}/effects-gallery.mp4", "preset": "9:16", "exportAnyway": true},
     "expect": {"result.duration": {"approx": "${state.duration}", "tol": 0.000001}, "result.width": 1080, "result.height": 1920}},
    {"command": "media.probe", "params": {"path": "${WORK}/effects-gallery.mp4"},
     "expect": {"result.duration": {"approx": "${state.duration}", "tol": 0.067}, "result.video.fps": "30/1"}},
    {"command": "media.checkSync", "params": {"path": "${WORK}/effects-gallery.mp4"},
     "expect": {"result.lagFrames": {"min": -0.99, "max": 0.99}, "result.correlation": {"min": 0.5}}},
    {"command": "frame.contactSheet", "params": {"times": [1, 2.5, 4, 5.8, 7.2, 9.6, 13, 16.6, 21.4, 22.4, 24.1, 25.6], "path": "${WORK}/effects-sheet.jpg"}},
    {"command": "effects.check", "params": {"path": "${WORK}/effects-gallery.mp4"},
     "expect": {"result.pass": true, "result.identity.maxDiff": 0, "result.captionBand": {"count": 0}, "result.items": {"count": 10},
                "result.speeds": {"count": 7}, "result.sync": {"count": 2}},
     "show": ["result.items", "result.sync", "result.speeds"]},
    {"command": "export.mlt", "params": {"path": "${WORK}/effects-gallery.mlt"}, "expect": {"result.warnings": {"count": 18}}, "show": ["result.warnings"]}
  ]
}
