{
  "name": "wesites-generate",
  "defaults": {"REGISTA_GOLDEN_MEDIA": "${HOME}/.config/regista/test-media/wesites-2026-10-26", "REGISTA_COMFY_RUN": "${HOME}/.config/regista/test-media/comfy_run.py"},
  "description": "Generated B-roll and text behind the person on the WeSites take: the wesites-v1 edit (auto cut, voice, punch-ins, grade, captions), then a ComfyUI still (Z-Image) animated into a 3 s clip (Wan 2.2 I2V from that still) and upscaled to 1080×1920 at 30 fps (Real-ESRGAN + RIFE), placed as a full-frame insert on \"il motore sotto ogni sito WordPress\" (8.37–10.17 s); the person matte of the first 3 s (Apple Vision) and the hook word \"SICURO?\" in big IKB serif behind the speaker's head (0.1–3 s). Checks: provider metadata on the generated assets, insert ≥ 1080 px and visible exactly in its window, title hidden where the person is and visible elsewhere (render and mp4), caption band clean, −15 ±0.5 LUFS / true peak ≤ −1.5 dBTP. Needs the engines, the footage and ComfyUI (Pro tier); generations are cached by request, so a re-run costs seconds.",
  "requires": ["engines", "footage", "comfyui"],
  "footage": ["${REGISTA_GOLDEN_MEDIA}/raw/IMG_3437.MOV", "${REGISTA_GOLDEN_MEDIA}/script.md",
              "${REGISTA_GOLDEN_MEDIA}/work/keywords.json", "${HOME}/.local/bin/comfy-gen",
              "${REGISTA_COMFY_RUN}"],
  "steps": [
    {"command": "project.new", "params": {"name": "wesites-generate", "directory": "${WORK}"}},
    {"command": "media.import", "params": {"path": "${REGISTA_GOLDEN_MEDIA}/raw/IMG_3437.MOV"}, "capture": {"raw": "result.asset.id"}},
    {"command": "media.extractAudio", "params": {"assetId": "${raw}"}},
    {"command": "transcript.run", "params": {"assetId": "${raw}", "language": "it"}, "expect": {"result.words": {"min": 190}}},
    {"command": "script.set", "params": {"path": "${REGISTA_GOLDEN_MEDIA}/script.md"}, "expect": {"result.count": 10}},
    {"command": "takes.list", "expect": {"result.read": 10}},
    {"command": "edit.autoCut", "expect": {"result.segments": {"count": 11}}, "capture": {"cut": "result"}},
    {"command": "audio.clean", "expect": {"result.loudness.integrated": {"approx": -15, "tol": 0.5}}},
    {"command": "edit.punchIns", "params": {"base": [864, 1536, 152, 384], "punch": [760, 1351, 204, 487], "by": "line"},
     "expect": {"result.clips": {"count": 11}}},
    {"command": "clip.set", "params": {"trackId": "${cut.videoTrackId}", "brightness": 0.02, "contrast": 1.06, "saturation": 1.08}},
    {"command": "captions.generate", "params": {"keywordsPath": "${REGISTA_GOLDEN_MEDIA}/work/keywords.json", "style": "talking-head-v1"},
     "expect": {"result.stale": false}},
    {"command": "brandkit.apply", "params": {"kit": "wesites"}},

    {"command": "generate.providers",
     "expect": {"result.providers.0.id": "comfyui", "result.providers.0.kinds.video.available": true,
                "result.providers.0.kinds.upscale.available": true, "result.providers.1.id": "higgsfield",
                "result.providers.1.paid": true, "result.providers.1.budgetCap": 2}},
    {"command": "generate.estimate",
     "params": {"kind": "image", "prompt": "Abstract dark server room, rows of softly glowing deep blue light panels receding into soft fog, cinematic, minimal, no text, no people, vertical composition"},
     "expect": {"result.credits": 0, "result.unit": "free", "result.paid": false}},
    {"command": "generate.run",
     "params": {"kind": "image", "keepRunning": true,
                "prompt": "Abstract dark server room, rows of softly glowing deep blue light panels receding into soft fog, cinematic, minimal, no text, no people, vertical composition"},
     "expect": {"result.status": "done", "result.asset.video.width": 720, "result.asset.video.height": 1280,
                "result.asset.generated.provider": "comfyui", "result.asset.generated.model": "z-image-turbo",
                "result.asset.generated.cost": 0, "result.seed": {"exists": true}},
     "capture": {"still": "result"}},
    {"command": "generate.run",
     "params": {"kind": "video", "refs": ["${still.assetId}"], "duration": 3, "keepRunning": true,
                "prompt": "slow forward dolly along the row of server racks, blue lights gently pulsing, soft fog drifting"},
     "expect": {"result.status": "done", "result.asset.video.width": 464, "result.asset.video.height": 832,
                "result.asset.duration": {"min": 2.9, "max": 3.2}, "result.asset.generated.kind": "video"},
     "capture": {"clip": "result"}},
    {"command": "generate.upscale", "params": {"assetId": "${clip.assetId}"},
     "expect": {"result.status": "done", "result.asset.video.width": {"min": 1080}, "result.asset.video.height": 1920,
                "result.asset.video.fps": 30, "result.asset.duration": {"min": 2.9, "max": 3.2},
                "result.asset.generated.model": "realesrgan-x4plus+rife-4.26"},
     "capture": {"up": "result"}},
    {"command": "generate.list",
     "expect": {"result.assets": {"count": 3}, "result.assets.2.sourceAssetId": "${clip.assetId}", "result.assets.1.sourceAssetId": "${still.assetId}"}},

    {"command": "overlay.add", "params": {"path": "${up.path}", "start": 8.36, "duration": 1.8, "fullFrame": true},
     "expect": {"result.clip.start": {"approx": 8.3667, "tol": 0.001}, "result.clip.duration": {"approx": 1.8, "tol": 0.04}},
     "capture": {"insert": "result"}},

    {"command": "matte.track", "params": {"from": 0, "to": 3},
     "expect": {"result.missing": 0, "result.frames": {"min": 85}, "result.coverage": {"min": 0.2, "max": 0.8}}},
    {"command": "title.add",
     "params": {"text": "SICURO?", "preset": "hook", "start": 0.1, "duration": 2.9, "size": 180, "background": "none",
                "color": "primary", "position": [510, 265], "shadow": false, "behindSubject": true, "animIn": "slideUp", "animOut": "fade"},
     "expect": {"result.clip.behindSubject": true, "result.warnings": {"count": 0}},
     "capture": {"hook": "result"}},
    {"command": "graphics.checkLayout", "expect": {"result.pass": true}},
    {"command": "graphics.checkBehindSubject", "params": {"clipId": "${hook.clip.id}"},
     "expect": {"result.pass": true, "result.hiddenRatio": {"min": 0.97}, "result.visibleRatio": {"min": 0.97},
                "result.personPixels": {"min": 1000}, "result.backgroundPixels": {"min": 1000}}},

    {"command": "export.render", "params": {"path": "${WORK}/wesites-generate.mp4", "preset": "9:16", "loudness": -15},
     "expect": {"result.frames": {"approx": 1470, "tol": 2}, "result.width": 1080, "result.height": 1920,
                "result.loudness.integrated": {"approx": -15, "tol": 0.5}, "result.loudness.truePeak": {"max": -1.5}}},
    {"command": "media.checkOverlay", "params": {"path": "${WORK}/wesites-generate.mp4", "trackId": "${insert.trackId}"},
     "expect": {"result.pass": true}},
    {"command": "graphics.checkBehindSubject", "params": {"clipId": "${hook.clip.id}", "path": "${WORK}/wesites-generate.mp4"},
     "expect": {"result.pass": true, "result.hiddenRatio": {"min": 0.9}, "result.visibleRatio": {"min": 0.9}}},
    {"command": "media.probe", "params": {"path": "${WORK}/wesites-generate.mp4"},
     "expect": {"result.video.width": 1080, "result.video.height": 1920, "result.video.fps": "30/1", "result.faststart": true}},
    {"command": "frame.contactSheet",
     "params": {"times": [0.3, 1.0, 1.7, 2.4, 8.4, 9.0, 9.6, 10.1, 10.4, 14.0], "path": "${WORK}/generate-contact.jpg"},
     "expect": {"result.path": {"exists": true}}},
    {"command": "project.save"}
  ]
}
