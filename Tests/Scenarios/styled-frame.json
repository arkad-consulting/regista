{
 "name": "styled-frame",
 "description": "Styled screen frame, keystroke overlay and 4:5 export (issue #44) on a synthetic recording session (recording.synthesize: an animated desktop, 8 s of the WeSites take as the camera, one logged cmd+s). 4:5 (1080×1350): recording.import with the aurum background frames the bubble layout (the screen padded and rounded on the gradient, the bubble straddling its bottom edge), keys.overlay puts the ⌘S badge inside the screen (one undo step), export in 4:5. 16:9: the screen layout framed on the default background (graphite, then the Arkad kit's own after brandkit.apply), the badge restyled by the kit. Contact sheets to look at. Needs only the footage (ffmpeg).",
 "requires": ["footage"],
 "defaults": {"REGISTA_GOLDEN_MEDIA": "${HOME}/.config/regista/test-media/wesites-2026-10-26"},
 "footage": ["${REGISTA_GOLDEN_MEDIA}/raw/IMG_3437.MOV"],
 "steps": [
  {"command": "recording.synthesize",
   "params": {"directory": "${WORK}/session", "camera": "${REGISTA_GOLDEN_MEDIA}/raw/IMG_3437.MOV", "cameraIn": 20, "duration": 8},
   "capture": {"synth": "result"}},

  {"command": "project.new", "params": {"name": "frame-45", "directory": "${WORK}", "width": 1080, "height": 1350}},
  {"command": "recording.import", "params": {"path": "${synth.session}", "background": "aurum"},
   "expect": {"result.layouts.0.layout": "bubble bottomRight circle M framed aurum", "state.settings.backdrop": "radial aurum"}},
  {"command": "layout.presets", "expect": {"result.presets": {"count": 6}, "result.frame.backgrounds": {"count": 6}, "result.frame.screen.2": 950}},
  {"command": "keys.overlay",
   "expect": {"result.badges": {"count": 1}, "result.badges.0.text": "⌘S", "result.badges.0.start": {"approx": 4.95, "tol": 0.04},
              "result.keys": 1, "state.history.nextUndo": "keys.overlay"}},
  {"command": "history.undo", "expect": {"result.undone": "keys.overlay"}},
  {"command": "history.redo", "expect": {"result.redone": "keys.overlay"}},
  {"command": "export.render", "params": {"path": "${WORK}/frame-45.mp4", "preset": "4:5"},
   "expect": {"result.width": 1080, "result.height": 1350, "result.preset": "4:5"}},
  {"command": "frame.contactSheet", "params": {"times": [1.0, 2.4, 5.2, 7.0], "path": "${WORK}/frame-45.jpg"},
   "expect": {"result.path": {"exists": true}}},

  {"command": "project.new", "params": {"name": "frame-169", "directory": "${WORK}", "width": 1920, "height": 1080}},
  {"command": "recording.import", "params": {"path": "${synth.session}", "layout": "screen", "frame": true},
   "expect": {"result.layouts.0.layout": "screen framed default", "state.settings.backdrop": "radial graphite"}},
  {"command": "keys.overlay", "params": {"allKeys": true}, "expect": {"result.badges": {"count": 1}}},
  {"command": "brandkit.apply", "params": {"kit": "arkad"}, "expect": {"state.settings.backdrop": "radial brand arkad"}},
  {"command": "frame.contactSheet", "params": {"times": [1.0, 2.4, 5.2, 7.0], "path": "${WORK}/frame-169.jpg"},
   "expect": {"result.path": {"exists": true}}}
 ]
}
