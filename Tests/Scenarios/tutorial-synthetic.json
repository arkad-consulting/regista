{
  "name": "tutorial-synthetic",
  "defaults": {"REGISTA_GOLDEN_MEDIA": "${HOME}/.config/regista/test-media/wesites-2026-10-26"},
  "description": "Screen + camera tutorial from a synthetic recording session (issue #6): recording.synthesize writes a session in the real format (an animated desktop at 1920×1080 60 fps with a cursor and 4 clicks, 14 s of the WeSites take as the camera, its sound as the mic, offsets screen 0 / camera 0.25 s / mic 0.18 s, 3 sync slates). 16:9: recording.import with face tracking, bubble bottom-right until 7 s then split, auto-zoom 1.8 on the clicks, export. 9:16 from the same session: vertical stack until 7 s then the person cut out (Vision matte) over a screen slice that follows the cursor, auto-zoom 1.4, export. Checks on both mp4s: camera↔mic and screen↔camera within one frame on the slates, the face (Vision on the export) inside the camera box where the layout puts it, the export zoomed at every click, the screen visible around the cut-out person; contact sheets. Needs Vision and the footage: skipped by the pre-commit hook.",
  "requires": ["engines", "footage"],
  "footage": ["${REGISTA_GOLDEN_MEDIA}/raw/IMG_3437.MOV"],
  "steps": [
    {"command": "recording.synthesize",
     "params": {"directory": "${WORK}/session", "camera": "${REGISTA_GOLDEN_MEDIA}/raw/IMG_3437.MOV", "cameraIn": 20, "duration": 14},
     "expect": {"result.screen.frames": 840, "result.screen.fps": 60, "result.clicks": {"count": 4}, "result.syncMarks": {"count": 3},
                "result.offsets.camera": 0.25},
     "capture": {"synth": "result"}},

    {"command": "project.new", "params": {"name": "tutorial-169", "directory": "${WORK}", "width": 1920, "height": 1080}},
    {"command": "recording.import", "params": {"path": "${synth.session}", "faces": true},
     "expect": {"result.origin": 0.25, "result.duration": {"approx": 13.7333, "tol": 0.001}, "result.synthetic": true,
                "result.sources.0.sourceIn": 0.25, "result.sources.1.sourceIn": 0, "result.sources.2.sourceIn": {"approx": 0.07, "tol": 0.000001},
                "result.events.clicks": 4, "result.events.keys": 1, "result.layouts.0.layout": "bubble bottomRight circle M",
                "state.tracks": {"count": 3}, "state.tracks.0.name": "Schermo", "state.tracks.1.name": "Camera", "state.tracks.2.name": "Microfono",
                "state.recordings.0.id": "r1"},
     "capture": {"rec": "result"}},
    {"command": "layout.presets", "expect": {"result.presets": {"count": 6}, "result.presets.0.camera.2": 324}},
    {"command": "layout.apply", "params": {"preset": "split", "from": 7},
     "expect": {"result.cameraClips": {"count": 1}, "result.warnings": {"count": 0}, "result.boxes": {"count": 2},
                "state.tracks.1.clips": {"count": 2}, "state.tracks.1.clips.1.start": 7, "state.settings.background": "#0F1013"}},
    {"command": "edit.autoZoom", "params": {"zoom": 1.8},
     "expect": {"result.clicks": {"count": 4}, "result.groups": 2,
                "result.clicks.0.time": {"approx": 2.35, "tol": 0.001}, "result.clicks.0.zoom": {"approx": 1.8, "tol": 0.03},
                "result.clicks.1.zoom": {"approx": 1.8, "tol": 0.03}, "result.clicks.2.zoom": {"approx": 1.8, "tol": 0.03},
                "result.clicks.3.zoom": {"approx": 1.8, "tol": 0.03}, "state.history.nextUndo": "edit.autoZoom"},
     "capture": {"zoomed": "state"}},
    {"command": "history.undo", "expect": {"result.undone": "edit.autoZoom", "state.history.nextUndo": "layout.apply"}},
    {"command": "history.redo", "expect": {"result.redone": "edit.autoZoom", "state.tracks": {"equals": "${zoomed.tracks}"}}},

    {"command": "export.render", "params": {"path": "${WORK}/tutorial-169.mp4", "preset": "16:9"},
     "expect": {"result.width": 1920, "result.height": 1080, "result.frames": 412}},
    {"command": "recording.check", "params": {"path": "${WORK}/tutorial-169.mp4"},
     "expect": {"result.pass": true, "result.sync.pass": true, "result.sync.marks": {"count": 3},
                "result.sync.worstCameraMicMs": {"max": 33.3}, "result.sync.worstScreenCameraMs": {"max": 33.3},
                "result.faces.pass": true, "result.faces.ratio": {"min": 0.9}, "result.zoom.pass": true, "result.zoom.clicks": {"count": 4}}},
    {"command": "frame.contactSheet",
     "params": {"times": [0.6, 2.35, 3.75, 5.6, 7.6, 8.95, 11.35, 13.2], "path": "${WORK}/tutorial-169.jpg"},
     "expect": {"result.path": {"exists": true}}},
    {"command": "project.save"},

    {"command": "project.new", "params": {"name": "tutorial-916", "directory": "${WORK}", "width": 1080, "height": 1920}},
    {"command": "recording.import", "params": {"path": "${synth.session}", "layout": "stack", "faces": true},
     "expect": {"result.layouts.0.layout": "stack face bottom"},
     "capture": {"rec916": "result"}},
    {"command": "matte.track", "params": {"assetId": "${rec916.assets.camera}", "from": 7},
     "expect": {"result.missing": 0, "result.coverage": {"min": 0.15, "max": 0.8}}},
    {"command": "layout.apply", "params": {"preset": "cutout", "from": 7},
     "expect": {"result.warnings": {"count": 0}, "state.tracks.1.clips.1.start": 7}},
    {"command": "edit.autoZoom", "params": {"zoom": 1.4, "follow": true},
     "expect": {"result.clicks": {"count": 4}, "result.follow": true, "result.clicks.0.zoom": {"approx": 1.4, "tol": 0.03},
                "result.clicks.2.zoom": {"min": 1.6, "max": 2.5}}},
    {"command": "export.render", "params": {"path": "${WORK}/tutorial-916.mp4", "preset": "9:16"},
     "expect": {"result.width": 1080, "result.height": 1920, "result.frames": 412}},
    {"command": "recording.check", "params": {"path": "${WORK}/tutorial-916.mp4"},
     "expect": {"result.pass": true, "result.sync.pass": true, "result.sync.worstCameraMicMs": {"max": 33.3},
                "result.sync.worstScreenCameraMs": {"max": 33.3}, "result.faces.pass": true, "result.zoom.pass": true,
                "result.cutout.pass": true, "result.cutout.screenVisibleRatio": {"min": 0.9}, "result.cutout.personCoversRatio": {"min": 0.9}}},
    {"command": "frame.contactSheet",
     "params": {"times": [0.6, 2.35, 3.75, 5.6, 7.6, 8.95, 11.35, 13.2], "path": "${WORK}/tutorial-916.jpg"},
     "expect": {"result.path": {"exists": true}}},
    {"command": "project.save"}
  ]
}
