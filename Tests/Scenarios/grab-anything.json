{
 "name": "grab-anything",
 "description": "Every element on the frame can be grabbed (#30), headless, through clip.place (the command a drag on the preview runs). A synthetic talking head fills the frame, with a full-frame card insert and a box callout over it: frame.elements lists them as picture, picture and callout. The camera is moved and shrunk (one undo step each: its first move turns \"fills the frame\" into a box as large as the frame), the insert moved, the callout moved and enlarged; exported 9:16, the camera and the callout are in the rendered frames where frame.elements says (media.checkPlacement); reset puts the camera back filling the frame. Then a synthetic screen + camera recording in 9:16: the camera bubble is a layoutBox, moved by hand, and layout.apply puts the preset's box back. Synthetic media, no engines, no footage (ffmpeg for the export).",
 "steps": [
  {"command": "project.new", "params": {"name": "grab-anything", "directory": "${WORK}"}},
  {"command": "media.synthesize", "params": {"path": "${WORK}/talking-head.mov", "duration": 6}, "capture": {"cam": "result.asset.id"}},
  {"command": "track.add", "params": {"kind": "video"}, "capture": {"v1": "result.track.id"}},
  {"command": "timeline.place", "params": {"assetId": "${cam}", "trackId": "${v1}", "sourceIn": 0, "sourceOut": 6}, "capture": {"camClip": "result.clip.id"}},
  {"command": "overlay.add", "params": {"path": "${SCENARIO_DIR}/../Fixtures/overlay-card.png", "start": 4, "duration": 2, "fit": "fill"},
   "capture": {"insert": "result.clip.id"}},
  {"command": "callout.add", "params": {"kind": "box", "start": 0, "duration": 4, "rect": [140, 300, 400, 220], "drawOn": 0, "color": "#FFD43B"},
   "capture": {"callout": "result.clip.id"}},
  {"command": "frame.elements", "params": {"time": 2},
   "expect": {"result.elements": {"count": 2}, "result.elements.0.kind": "picture", "result.elements.0.clipId": "${camClip}",
              "result.elements.0.movable": true, "result.elements.1.kind": "callout"}},
  {"command": "frame.elements", "params": {"time": 5},
   "expect": {"result.elements": {"count": 2}, "result.elements.1.kind": "picture", "result.elements.1.clipId": "${insert}"}},
  {"command": "clip.place", "params": {"clipId": "${camClip}", "dx": 160, "dy": 240},
   "expect": {"result.kind": "picture", "result.manual": true, "result.clamped": false, "result.center.0": {"approx": 700, "tol": 0.5},
              "result.center.1": {"approx": 1200, "tol": 0.5}}},
  {"command": "history.undo", "expect": {"state.tracks.0.clips.0.transform": {"exists": false}}},
  {"command": "history.redo"},
  {"command": "clip.place", "params": {"clipId": "${camClip}", "scale": 0.6},
   "expect": {"result.box.2": {"approx": 648, "tol": 0.5}, "result.box.3": {"approx": 1152, "tol": 0.5}}},
  {"command": "clip.place", "params": {"clipId": "${insert}", "dy": -400, "scale": 0.5}, "expect": {"result.kind": "picture", "result.box.2": {"approx": 540, "tol": 0.5}}},
  {"command": "clip.place", "params": {"clipId": "${callout}", "dx": 60, "dy": 900, "scale": 1.3},
   "expect": {"result.kind": "callout", "result.center.0": {"approx": 400, "tol": 0.5}, "result.center.1": {"approx": 1310, "tol": 0.5}}},
  {"command": "clip.place", "params": {"clipId": "${callout}", "rotation": 10}, "expectError": "does not turn"},
  {"command": "frame.elements", "params": {"time": 2},
   "expect": {"result.elements.0.manual": true, "result.elements.0.scale": {"approx": 0.6, "tol": 0.001}, "result.elements.1.manual": true}},
  {"command": "export.render", "params": {"path": "${WORK}/grab-anything.mp4"}, "expect": {"result.duration": {"approx": 6, "tol": 0.05}}},
  {"command": "media.checkPlacement", "params": {"path": "${WORK}/grab-anything.mp4", "clipId": "${camClip}", "time": 2}, "expect": {"result.pass": true}},
  {"command": "media.checkPlacement", "params": {"path": "${WORK}/grab-anything.mp4", "clipId": "${callout}", "time": 2, "tolerance": 6}, "expect": {"result.pass": true}},
  {"command": "frame.render", "params": {"time": 2, "path": "${WORK}/grab-anything-2s.png", "inline": false}},
  {"command": "clip.place", "params": {"clipId": "${camClip}", "reset": true}, "expect": {"result.manual": false, "result.box.2": {"approx": 1080, "tol": 0.5}}},

  {"command": "recording.synthesize", "params": {"directory": "${WORK}/session", "camera": "${WORK}/talking-head.mov", "sources": ["screen", "camera"], "duration": 4},
   "capture": {"synth": "result"}},
  {"command": "project.new", "params": {"name": "grab-recording", "directory": "${WORK}", "width": 1080, "height": 1920}},
  {"command": "recording.import", "params": {"path": "${synth.session}", "layout": "bubble"}},
  {"command": "frame.elements", "params": {"time": 1},
   "expect": {"result.elements.1.kind": "layoutBox", "result.elements.1.movable": true}, "capture": {"bubble": "result.elements.1.clipId"}},
  {"command": "clip.place", "params": {"clipId": "${bubble}", "dx": -300, "dy": -500, "scale": 1.5},
   "expect": {"result.kind": "layout box", "result.manual": true}},
  {"command": "frame.elements", "params": {"time": 1}, "expect": {"result.elements.1.manual": true, "result.elements.1.scale": {"approx": 1.5, "tol": 0.001}}},
  {"command": "layout.apply", "params": {"preset": "bubble"}},
  {"command": "frame.elements", "params": {"time": 1}, "expect": {"result.elements.1.manual": false, "result.elements.1.scale": 1}}
 ]
}
