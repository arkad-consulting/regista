{
 "name": "caption-place",
 "description": "Moving captions and graphics by hand (issue #21) on the WeSites take: 12 s placed, transcribed, captioned; the whole caption track moved to the top left (left edge x 60, centre y 300), one chunk lower and bigger (centre y 1400, 1.35×), a title and a sticker moved (and the sticker resized), exported 9:16. Checks in the rendered frames (media.checkPlacement: the frame decoded from the mp4 against the same frame rendered without the element) that the moved chunk, an unmoved chunk, the title and the sticker are where requested within 4 px; caption timing still exact with the moved/scaled bands; the Shotcut export opens; each placement one undo step. Needs whisper for the captions and the footage: skipped by the pre-commit hook.",
 "requires": ["engines", "footage"],
 "defaults": {
  "REGISTA_GOLDEN_MEDIA": "${HOME}/.config/regista/test-media/wesites-2026-10-26",
  "REGISTA_TEST_MEDIA": "${REGISTA_GOLDEN_MEDIA}/raw/IMG_3437.MOV"
 },
 "footage": ["${REGISTA_TEST_MEDIA}"],
 "steps": [
  {"command": "project.new", "params": {"name": "caption-place", "directory": "${WORK}"}},
  {"command": "media.import", "params": {"path": "${REGISTA_TEST_MEDIA}"}, "capture": {"raw": "result.asset.id"}},
  {"command": "track.add", "params": {"kind": "video"}, "capture": {"v1": "result.track.id"}},
  {"command": "timeline.place", "params": {"assetId": "${raw}", "trackId": "${v1}", "sourceIn": 0, "sourceOut": 12}},
  {"command": "transcript.run", "params": {"assetId": "${raw}", "language": "it"}, "expect": {"result.words": {"min": 20}}},
  {"command": "captions.generate", "params": {"keywords": ["SITO", "SICURO", "AGGIORNATO"]},
   "expect": {"result.chunks": {"min": 5}}, "capture": {"captions": "result.trackId"}},

  {"command": "captions.place", "params": {"x": 60, "y": 300, "align": "left"},
   "expect": {"result.scope": "track", "result.trackPlace.x": 60, "result.trackPlace.y": 300, "result.trackPlace.align": "left",
              "result.clamped": 0, "result.chunks.0.line.0": {"approx": 60, "tol": 1}}},
  {"command": "captions.place", "params": {"chunk": 2, "y": 1400, "scale": 1.35},
   "expect": {"result.scope": "chunks", "result.chunks.0.chunk": 2, "result.chunks.0.center.1": {"approx": 1400, "tol": 2},
              "result.chunks.0.line.0": {"approx": 60, "tol": 1}, "result.chunks.0.clamped": false,
              "state.tracks.1.captions.placedChunks": 1}},
  {"command": "history.undo", "expect": {"state.tracks.1.captions.placedChunks": 0, "state.tracks.1.captions.place.x": 60}},
  {"command": "captions.get", "expect": {"result.list.2.place": null}},
  {"command": "history.redo", "expect": {"state.tracks.1.captions.placedChunks": 1}},
  {"command": "captions.get", "expect": {"result.list.2.place.y": 1400, "result.list.2.place.scale": 1.35, "result.trackPlace.align": "left"}},

  {"command": "title.add", "params": {"text": "SPOSTAMI", "start": 1, "duration": 4, "position": [540, 900], "size": 80, "color": "#FFFFFF",
                                      "background": "box", "backgroundColor": "#141414", "padding": [28, 18], "shadow": false},
   "capture": {"title": "result.clip.id"}},
  {"command": "clip.place", "params": {"clipId": "${title}", "x": 700, "y": 1000},
   "expect": {"result.center.0": {"approx": 700, "tol": 0.5}, "result.center.1": {"approx": 1000, "tol": 0.5}, "result.clamped": false}},
  {"command": "sticker.add", "params": {"sticker": "fire", "start": 2, "duration": 3}, "capture": {"sticker": "result.clip.id"}},
  {"command": "clip.place", "params": {"clipId": "${sticker}", "x": 250, "y": 700, "scale": 1.5},
   "expect": {"result.center.0": {"approx": 250, "tol": 0.5}, "result.center.1": {"approx": 700, "tol": 0.5}, "result.clip.transform.scale": 1.5}},
  {"command": "history.undo", "expect": {"result.undone": "clip.place"}},
  {"command": "history.redo"},
  {"command": "frame.elements", "params": {"time": 3},
   "expect": {"result.elements": {"count": 4, "includes": [{"clipId": "${title}"}, {"clipId": "${sticker}"}]},
              "result.elements.0.kind": "picture", "result.elements.3.kind": "caption"}},

  {"command": "export.render", "params": {"path": "${WORK}/caption-place.mp4", "preset": "9:16"}, "expect": {"result.frames": 360}},
  {"command": "project.save"},
  {"command": "media.checkPlacement", "params": {"path": "${WORK}/caption-place.mp4", "chunk": 2},
   "expect": {"result.pass": true, "result.foundCenter.1": {"approx": 1400, "tol": 4}, "result.found.0": {"approx": 60, "tol": 4}}},
  {"command": "media.checkPlacement", "params": {"path": "${WORK}/caption-place.mp4", "chunk": 0},
   "expect": {"result.pass": true, "result.foundCenter.1": {"approx": 300, "tol": 4}, "result.found.0": {"approx": 60, "tol": 4}}},
  {"command": "media.checkPlacement", "params": {"path": "${WORK}/caption-place.mp4", "chunk": 3},
   "expect": {"result.pass": true, "result.foundCenter.1": {"approx": 300, "tol": 4}, "result.found.0": {"approx": 60, "tol": 4}}},
  {"command": "media.checkPlacement", "params": {"path": "${WORK}/caption-place.mp4", "clipId": "${title}"},
   "expect": {"result.pass": true, "result.foundCenter.0": {"approx": 700, "tol": 4}, "result.foundCenter.1": {"approx": 1000, "tol": 4}}},
  {"command": "media.checkPlacement", "params": {"path": "${WORK}/caption-place.mp4", "clipId": "${sticker}"},
   "expect": {"result.pass": true, "result.foundCenter.0": {"approx": 250, "tol": 4}, "result.foundCenter.1": {"approx": 700, "tol": 4}}},
  {"command": "captions.checkTiming", "params": {"path": "${WORK}/caption-place.mp4"},
   "expect": {"result.pass": true, "result.maxAbsError": {"max": 1}, "result.band.placedChunks": {"min": 1}}},
  {"command": "export.mlt", "params": {"path": "${WORK}/caption-place.mlt"}, "expect": {"result.captionImages": {"min": 5}}},
  {"command": "captions.place", "params": {"reset": true}, "expect": {"result.trackPlace": null, "result.placedChunks": 0}},
  {"command": "history.undo", "expect": {"state.tracks.1.captions.place.x": 60}},
  {"command": "captions.get", "expect": {"result.list.2.place.y": 1400, "result.placedChunks": 1}}
 ]
}
