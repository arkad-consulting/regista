{
 "name": "motion-gallery",
 "description": "Every motion template (issue #22) on a synthetic talking head (media.synthesize: a speaker silhouette with its exact person matte, so the behind/in-front layering is tested without footage or Vision), in the Arkad kit: each template added with motion.add in its own 3 s window (no warnings), the catalog lists them all, effects.preview renders one without touching the edit or the undo history, effects.check finds every template visible at three moments and none of their ink in the caption band (templates that cover the frame by design are exempt), exported 9:16 anyway (a gallery: its templates' texts are not timed to be read, so the reading-time rule fails by design). Needs no engines and no footage (ffmpeg only for the export).",
 "steps": [
  {
   "command": "project.new",
   "params": {
    "name": "motion-gallery",
    "directory": "${WORK}"
   }
  },
  {
   "command": "media.synthesize",
   "params": {
    "path": "${WORK}/talking-head.mov",
    "duration": 106
   },
   "capture": {
    "cam": "result.asset.id"
   },
   "expect": {
    "result.frames": 3180
   }
  },
  {
   "command": "track.add",
   "params": {
    "kind": "video"
   },
   "capture": {
    "v": "result.track.id"
   }
  },
  {
   "command": "timeline.place",
   "params": {
    "assetId": "${cam}",
    "trackId": "${v}",
    "sourceIn": 0,
    "sourceOut": 106
   }
  },
  {
   "command": "brandkit.apply",
   "params": {
    "kit": "arkad",
    "captions": false
   }
  },
  {
   "command": "effects.catalog",
   "params": {
    "category": "templates"
   },
   "expect": {
    "result.items": {
     "count": 37
    }
   }
  },
  {
   "command": "motion.add",
   "params": {
    "template": "orbit-carousel",
    "start": 0.3,
    "duration": 2.7
   },
   "expect": {
